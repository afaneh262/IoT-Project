# ============================================================================
# MongoDB Configuration for Smart Home IoT Data Warehouse
# ============================================================================

# MongoDB Root Credentials
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=smartHomeAdmin2024
MONGO_DATABASE=smart_home_iot

# MongoDB Connection URI
# For local Docker (app running on host): 
MONGO_URI=mongodb://admin:smartHomeAdmin2024@localhost:27017/smart_home_iot?authSource=admin
# For containerized app (uncomment if running app in Docker):
# MONGO_URI=mongodb://admin:smartHomeAdmin2024@mongodb:27017/smart_home_iot?authSource=admin

# Mongo Express Web UI Configuration (http://localhost:8081)
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=pass

# ============================================================================
# Application Settings
# ============================================================================

# Enable/disable data storage to MongoDB
DATA_STORAGE_ENABLED=true

# Batch size for bulk inserts (higher = better performance, but more memory)
BATCH_SIZE=100

# Data transmission format for sensor-to-server communication
# Options: json, xml, mixed
# - json: All data transmitted in JSON format
# - xml: All data transmitted in XML format
# - mixed: Randomly alternates between JSON and XML (50/50 split)
DATA_FORMAT_MODE=mixed

# ============================================================================
# Instructions
# ============================================================================
# 1. Copy this file to .env: cp .env.example .env
# 2. Modify values as needed
# 3. Start MongoDB: docker-compose up -d
# 4. Run application: python main.py
